# 실제 값은 .env.local(로컬) 또는 Vercel 환경 변수에 넣는다. 이 파일은 항목 이름만 적는다.
# 보고 실행 시각은 환경 변수가 아니라 vercel.json의 crons에서 정한다.

# Gemini API (모델 이름은 3.2에서 확정)
GEMINI_API_KEY=
GEMINI_MODEL=

# 단축어 → 입력 엔드포인트 인증용 공유 비밀값
INTAKE_SECRET=

# 벨루 비서 전용 계정 (로그인 방식은 task 1.2에서 확정, 아래 항목은 잠정)
VELOO_BASE_URL=
VELOO_USERNAME=
VELOO_PASSWORD=

# Gmail 읽기 전용 OAuth (task 1.3)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# 카카오 나에게 보내기 (task 1.4)
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

# 메일 선별 키워드, 쉼표로 구분 (task 5.4에서 확정)
MAIL_KEYWORDS=

# --- 구현하면서 추가된 항목 (값은 비워 둔다) ---
# 카카오 앱에서 Client Secret을 켠 경우 토큰 발급·갱신에 필요하다.
KAKAO_CLIENT_SECRET=
# Cron 호출 인증. 설정하면 Vercel이 호출 때 Authorization: Bearer 를 자동으로 붙인다.
CRON_SECRET=
# 처리 이력·토큰 저장소 (supabase/assistant.sql을 먼저 실행)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# 메일 조회 기간(일), 비워 두면 2
MAIL_LOOKBACK_DAYS=
